# Online payments (Stripe). Leave unset to fall back to emailed order requests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: the site's public URL for Stripe return links (detected automatically if unset)
SITE_URL=

# Email delivery for paid orders, share enquiries and contact messages (via Resend).
# Leave unset in development to log messages to the console instead.
RESEND_API_KEY=
ORDER_EMAIL_TO=
ORDER_EMAIL_FROM=
